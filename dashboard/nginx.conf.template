server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Use Amazon DNS resolver for runtime resolution
    resolver 169.254.169.253 valid=10s;

    # Control plane management API
    location /api/management/ {
        set $upstream_cp ${CP_HOST}:${CP_MGMT_PORT};
        proxy_pass http://$upstream_cp/management/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Health endpoints
    location /api/health/cp {
        set $upstream_cp_health ${CP_HOST}:${CP_HEALTH_PORT};
        proxy_pass http://$upstream_cp_health/api/check/health;
    }
    location /api/health/dp {
        set $upstream_dp_health ${DP_HOST}:${DP_HEALTH_PORT};
        proxy_pass http://$upstream_dp_health/api/check/health;
    }
    location /api/health/ih {
        set $upstream_ih_health ${IH_HOST}:${IH_HEALTH_PORT};
        proxy_pass http://$upstream_ih_health/api/check/health;
    }

    # Data plane public API (for EDR data fetch)
    # Browser sends token via X-Edr-Token; nginx converts to Authorization: Bearer
    location = /api/public {
        set $upstream_dp_public ${DP_HOST}:${DP_PUBLIC_PORT};
        proxy_pass http://$upstream_dp_public/public;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer $http_x_edr_token";
    }
    location /api/public/ {
        set $upstream_dp_public ${DP_HOST}:${DP_PUBLIC_PORT};
        proxy_pass http://$upstream_dp_public/public/;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer $http_x_edr_token";
    }

    # SPA fallback — no-cache on HTML so new deploys are picked up immediately
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
