        {
          "index_key": "dataplane",
          "schema_version": 1,
          "attributes": {
            "arn": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-dataplane-dev:1",
            "arn_without_revision": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-dataplane-dev",
            "container_definitions": "[{\"command\":[\"sh\",\"-c\",\"unset WEB_HTTP_PORT WEB_HTTP_PATH \u0026\u0026 printf '%s\\n' \\\"$DATAPLANE_CONFIG\\\" \u003e /tmp/dataplane-connector.properties \u0026\u0026 printf '%s\\n' \\\"$PRIVATE_KEY_PEM\\\" \u003e /tmp/private-key.pem \u0026\u0026 printf '%s\\n' \\\"$PUBLIC_KEY_PEM\\\" \u003e /tmp/public-key.pem \u0026\u0026 exec java -Djava.security.egd=file:/dev/urandom -Dedc.fs.config=/tmp/dataplane-connector.properties -jar edc-dataplane.jar\"],\"environment\":[{\"name\":\"DATAPLANE_CONFIG\",\"value\":\"edc.participant.id=connector\\nedc.hostname=pilots.t-mining.ma-de.be\\n\\n# Base listener (THIS is the one that defaulted to 8181)\\nweb.http.port=38181\\nweb.http.path=/api\\n\\n# Data plane control API\\nweb.http.control.port=38182\\nweb.http.control.path=/control\\n\\n# Data plane public API\\nweb.http.public.port=38185\\nweb.http.public.path=/public\\n\\n# selector is on controlplane management context (we confirmed v3 works there)\\nedc.dpf.selector.url=http://controlplane.pilots.internal:19192/control/v1/dataplanes\\nedc.api.auth.key=password\\n\\n# transfer proxy token keys\\nedc.transfer.proxy.token.signer.privatekey.alias=private-key\\nedc.transfer.proxy.token.verifier.publickey.alias=public-key\\nedc.transfer.proxy.token.signer.privatekey.path=/tmp/private-key.pem\\nedc.transfer.proxy.token.verifier.publickey.path=/tmp/public-key.pem\\n\\nedc.dataplane.api.public.baseurl=https://pilots.t-mining.ma-de.be/data/public\\n\\n# PostgreSQL persistence\\nedc.sql.schema.autocreate=true\\nedc.datasource.default.url=jdbc:postgresql://postgres.pilots.internal:5432/dataplane\\nedc.datasource.default.user=edc\\nedc.datasource.default.password=edc\\n\\n# HashiCorp Vault\\nedc.vault.hashicorp.url=http://vault.pilots.internal:8200\\nedc.vault.hashicorp.token=root-token\\n\"},{\"name\":\"PRIVATE_KEY_PEM\",\"value\":\"-----BEGIN PRIVATE KEY-----\\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg0Ttc9PcCD4HFmK/u\\nvmbjLLvAAGP7My4vssrPMo816RihRANCAATSw8dND1tlnpQaenBkvfbhLYUbbPyJ\\n+oRCFWKve8UO6/lzMTnfDJfYPNppoMj7AXB1XOmqRYTyYluwxAznAb08\\n-----END PRIVATE KEY-----\"},{\"name\":\"PUBLIC_KEY_PEM\",\"value\":\"-----BEGIN PUBLIC KEY-----\\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE0sPHTQ9bZZ6UGnpwZL324S2FG2z8\\nifqEQhVir3vFDuv5czE53wyX2DzaaaDI+wFwdVzpqkWE8mJbsMQM5wG9PA==\\n-----END PUBLIC KEY-----\"}],\"essential\":true,\"image\":\"ghcr.io/pilots-community/pilots-dataspace/dataplane:latest\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-region\":\"eu-west-3\",\"awslogs-stream-prefix\":\"dataplane\",\"awslogs-group\":\"/ecs/pilots-dev\"}},\"mountPoints\":[],\"name\":\"dataplane\",\"portMappings\":[{\"containerPort\":38185,\"hostPort\":38185,\"protocol\":\"tcp\"}],\"repositoryCredentials\":{\"credentialsParameter\":\"arn:aws:secretsmanager:eu-west-3:749957794341:secret:pilots-ghcr-credentials-qe2za2\"},\"systemControls\":[],\"volumesFrom\":[]}]",
