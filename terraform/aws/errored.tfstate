        {
          "index_key": "did-server",
          "schema_version": 1,
          "attributes": {
            "arn": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-did-server-dev:1",
            "arn_without_revision": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-did-server-dev",
            "container_definitions": "[{\"command\":[\"sh\",\"-c\",\"mkdir -p /usr/share/nginx/html/.well-known \u0026\u0026 printf '%s\\n' \\\"$NGINX_CONF\\\" \u003e /etc/nginx/conf.d/default.conf \u0026\u0026 printf '%s\\n' \\\"$ISSUER_DID_JSON\\\" \u003e /usr/share/nginx/html/.well-known/did.json \u0026\u0026 exec nginx -g 'daemon off;'\"],\"environment\":[{\"name\":\"ISSUER_DID_JSON\",\"value\":\"{\\n  \\\"@context\\\": [\\n    \\\"https://www.w3.org/ns/did/v1\\\",\\n    \\\"https://w3id.org/security/suites/jws-2020/v1\\\"\\n  ],\\n  \\\"id\\\": \\\"did:web:did-server%3A9876\\\",\\n  \\\"verificationMethod\\\": [\\n    {\\n      \\\"id\\\": \\\"did:web:did-server%3A9876#issuer-key-1\\\",\\n      \\\"type\\\": \\\"JsonWebKey2020\\\",\\n      \\\"controller\\\": \\\"did:web:did-server%3A9876\\\",\\n      \\\"publicKeyJwk\\\": {\\n        \\\"kty\\\": \\\"EC\\\",\\n        \\\"crv\\\": \\\"P-256\\\",\\n        \\\"x\\\": \\\"FUoRUcEgqN7ayMITC-MsniHYEzayWypf11lMjPEctCg\\\",\\n        \\\"y\\\": \\\"-Qwhyl4tNke7RLGvjRr9rdFaCJ6qzF7BAOIYZDlgoV0\\\",\\n        \\\"kid\\\": \\\"issuer-key-1\\\"\\n      }\\n    }\\n  ],\\n  \\\"authentication\\\": [\\n    \\\"did:web:did-server%3A9876#issuer-key-1\\\"\\n  ],\\n  \\\"assertionMethod\\\": [\\n    \\\"did:web:did-server%3A9876#issuer-key-1\\\"\\n  ]\\n}\"},{\"name\":\"NGINX_CONF\",\"value\":\"server {\\n    listen 9876;\\n    server_name _;\\n\\n    location /.well-known/did.json {\\n        root /usr/share/nginx/html;\\n        default_type application/json;\\n        add_header Access-Control-Allow-Origin *;\\n    }\\n}\"}],\"essential\":true,\"image\":\"nginx:alpine\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-group\":\"/ecs/pilots-dev\",\"awslogs-region\":\"eu-west-3\",\"awslogs-stream-prefix\":\"did-server\"}},\"mountPoints\":[],\"name\":\"did-server\",\"portMappings\":[{\"containerPort\":9876,\"hostPort\":9876,\"protocol\":\"tcp\"}],\"systemControls\":[],\"volumesFrom\":[]}]",
            "cpu": "256",
