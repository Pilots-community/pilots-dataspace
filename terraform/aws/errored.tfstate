        {
          "index_key": "controlplane",
          "schema_version": 1,
          "attributes": {
            "arn": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-controlplane-dev:1",
            "arn_without_revision": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-controlplane-dev",
            "container_definitions": "[{\"command\":[\"sh\",\"-c\",\"unset WEB_HTTP_PORT WEB_HTTP_PATH \u0026\u0026 printf '%s\\n' \\\"$CONTROLPLANE_CONFIG\\\" \u003e /tmp/controlplane-connector.properties \u0026\u0026 exec java -Djava.security.egd=file:/dev/urandom -Dedc.fs.config=/tmp/controlplane-connector.properties -jar edc-controlplane.jar\"],\"environment\":[{\"name\":\"CONTROLPLANE_CONFIG\",\"value\":\"# identity\\nedc.participant.id=did:web:pilots.t-mining.ma-de.be%3A7093\\nedc.hostname=pilots.t-mining.ma-de.be\\n\\n# Base listener (explicit to avoid port conflicts)\\nweb.http.port=18181\\nweb.http.path=/api\\n\\n# Management API\\nweb.http.management.port=19193\\nweb.http.management.path=/management\\nedc.api.auth.key=password\\n\\n# Dataspace Protocol API\\nweb.http.protocol.port=19194\\nweb.http.protocol.path=/protocol\\nedc.dsp.callback.address=https://pilots.t-mining.ma-de.be/dsp/protocol\\n\\n# Control API (internal)\\nweb.http.control.port=19192\\nweb.http.control.path=/control\\n\\n# DCP / Identity\\nedc.iam.issuer.id=did:web:pilots.t-mining.ma-de.be%3A7093\\nedc.iam.did.web.use.https=true\\nedc.iam.sts.privatekey.alias=did:web:pilots.t-mining.ma-de.be%3A7093-alias\\nedc.iam.sts.publickey.id=did:web:pilots.t-mining.ma-de.be%3A7093#key-1\\nedc.iam.sts.oauth.client.id=did:web:pilots.t-mining.ma-de.be%3A7093\\nedc.iam.sts.oauth.client.secret.alias=did:web:pilots.t-mining.ma-de.be%3A7093-sts-client-secret\\nedc.iam.sts.oauth.token.url=http://identityhub.pilots.internal:7096/api/sts/token\\n\\n# PostgreSQL persistence\\nedc.sql.schema.autocreate=true\\nedc.datasource.default.url=jdbc:postgresql://postgres.pilots.internal:5432/controlplane\\nedc.datasource.default.user=edc\\nedc.datasource.default.password=edc\\n\\n# HashiCorp Vault\\nedc.vault.hashicorp.url=http://vault.pilots.internal:8200\\nedc.vault.hashicorp.token=root-token\\n\"}],\"essential\":true,\"image\":\"ghcr.io/pilots-community/pilots-dataspace/controlplane:latest\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-stream-prefix\":\"controlplane\",\"awslogs-group\":\"/ecs/pilots-dev\",\"awslogs-region\":\"eu-west-3\"}},\"mountPoints\":[],\"name\":\"controlplane\",\"portMappings\":[{\"containerPort\":19194,\"hostPort\":19194,\"protocol\":\"tcp\"}],\"repositoryCredentials\":{\"credentialsParameter\":\"arn:aws:secretsmanager:eu-west-3:749957794341:secret:pilots-ghcr-credentials-qe2za2\"},\"systemControls\":[],\"volumesFrom\":[]}]",
            "cpu": "256",
