          "index_key": "identityhub",
          "schema_version": 1,
          "attributes": {
            "arn": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-identityhub-dev:1",
            "arn_without_revision": "arn:aws:ecs:eu-west-3:749957794341:task-definition/pilots-identityhub-dev",
            "container_definitions": "[{\"command\":[\"sh\",\"-c\",\"printf '%s\\n' \\\"$IDENTITYHUB_CONFIG\\\" \u003e /tmp/identityhub-connector.properties \u0026\u0026 exec java -Djava.security.egd=file:/dev/urandom -Dedc.fs.config=/tmp/identityhub-connector.properties -jar identityhub.jar\"],\"environment\":[{\"name\":\"IDENTITYHUB_CONFIG\",\"value\":\"# Base listener\\nweb.http.port=7090\\nweb.http.path=/api\\n\\n# Credentials API\\nweb.http.credentials.port=7091\\nweb.http.credentials.path=/api/credentials\\n\\n# Identity API (participant management)\\nweb.http.identity.port=7092\\nweb.http.identity.path=/api/identity\\n\\n# DID API (did:web resolution endpoint)\\nweb.http.did.port=7093\\nweb.http.did.path=/\\n\\n# Version API\\nweb.http.version.port=7095\\nweb.http.version.path=/api/version\\n\\n# STS API (embedded)\\nweb.http.sts.port=7096\\nweb.http.sts.path=/api/sts\\n\\n# DID Web\\nedc.iam.did.web.use.https=true\\nedc.hostname=pilots.t-mining.ma-de.be\\n\\n# STS key aliases (seeded by did-example-resolver)\\nedc.iam.sts.privatekey.alias=did:web:pilots.t-mining.ma-de.be%3A7093-alias\\nedc.iam.sts.publickey.id=did:web:pilots.t-mining.ma-de.be%3A7093#key-1\\n\\n# Super-user seed config\\nedc.ih.api.superuser.key=c3VwZXItdXNlcg==.superuser-token\\n\\n# PostgreSQL persistence\\nedc.sql.schema.autocreate=true\\nedc.datasource.default.url=jdbc:postgresql://postgres.pilots.internal:5432/identityhub\\nedc.datasource.default.user=edc\\nedc.datasource.default.password=edc\\n\\n# HashiCorp Vault\\nedc.vault.hashicorp.url=http://vault.pilots.internal:8200\\nedc.vault.hashicorp.token=root-token\\n\"}],\"essential\":true,\"image\":\"ghcr.io/pilots-community/pilots-dataspace/identityhub:latest\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-stream-prefix\":\"identityhub\",\"awslogs-group\":\"/ecs/pilots-dev\",\"awslogs-region\":\"eu-west-3\"}},\"mountPoints\":[],\"name\":\"identityhub\",\"portMappings\":[{\"containerPort\":7091,\"hostPort\":7091,\"protocol\":\"tcp\"}],\"repositoryCredentials\":{\"credentialsParameter\":\"arn:aws:secretsmanager:eu-west-3:749957794341:secret:pilots-ghcr-credentials-qe2za2\"},\"systemControls\":[],\"volumesFrom\":[]}]",
